#!/bin/sh
# Hard rule (DECISIONS.doc_drift_policy / risk R8): any change to DECISIONS.md
# must be accompanied by a CHANGELOG.md entry in the same commit.
# Enable once per clone:  git config core.hooksPath .githooks
staged=$(git diff --cached --name-only)
printf '%s\n' "$staged" | grep -qx 'DECISIONS.md' || exit 0
printf '%s\n' "$staged" | grep -qx 'CHANGELOG.md' && exit 0
echo "pre-commit: DECISIONS.md is staged but CHANGELOG.md is not." >&2
echo "Add a CHANGELOG.md entry in the same commit (doc_drift_policy)." >&2
exit 1
